NODE_ENV=development
# If your platform uses lowercase env keys, `node_env` is also supported:
# node_env=development

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Litecheats Enquiry <onboarding@resend.dev>"
RESEND_TO_EMAIL=support@litecheats.com

# Default public URL, used for links in email when we cannot tell which of your
# domains an account belongs to. No trailing slash.
PUBLIC_APP_URL=http://localhost:8080

# Every domain this app is served from, comma separated. An account remembers
# which one it signed up / signs in on, and email links point back there. A
# request Host or Origin outside this list is ignored, so a forged header can
# never redirect our email links to someone else's site.
# PUBLIC_APP_ORIGINS=https://litecheats.com,https://litecheats.in

# MongoDB connection string (Atlas: Connect > Drivers). Required. The cluster must
# be a replica set, which every Atlas cluster is, because wallet and renewal
# writes use multi-document transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=litecheats

# Database name. Collections, validators and indexes are created automatically on
# first boot. Defaults to litecheats_pwa. Only this exact variable is read, so a
# stray MONGODB_DB from another project can never redirect the app.
MONGODB_DB_NAME=litecheats_pwa

# Only used by `bun scripts/migrate-sqlite-to-mongo.ts`, to find the old SQLite file.
# SQLITE_PATH=./data/litecheats.sqlite

# Owner account, seeded automatically on first boot if no owner exists yet.
# Leave OWNER_PASSWORD unset to have a random password generated and printed
# once to the server console on first run.
OWNER_EMAIL=owner@litecheats.com
OWNER_PASSWORD=
OWNER_FULL_NAME=Owner
OWNER_COMPANY=Litecheats Technologies

# ---------------------------------------------------------------------------
# WhatsApp sign-in and signup
# ---------------------------------------------------------------------------
# OTP gateway base URL, up to and including the session id. The app calls
# {URL}/send and {URL}/verify. WhatsApp sign-in answers 503 until both are set.
# A trycloudflare.com URL changes every time its tunnel restarts; update it here.
WHATSAPP_OTP_API_URL=https://determining-adjustment-december-twelve.trycloudflare.com/api/otp/d3nngw
WHATSAPP_OTP_API_KEY=
# Country code added to a bare 10-digit number. Set it empty to require "+".
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# How long we accept a code after sending it, in ms. Default 10 minutes.
# WHATSAPP_OTP_TTL_MS=600000
# Per-IP limits per minute on sending codes and on checking them.
# AUTH_WHATSAPP_SEND_RATE_LIMIT=5
# AUTH_WHATSAPP_VERIFY_RATE_LIMIT=10

# Webhook for gateway events (messages, status, connection, groups, contacts...).
# In the gateway, create a webhook with URL https://<your domain>/whatsapp/webhook,
# tick the events you want, and set its secret to the same value as here.
# Deliveries are rejected with 401 while this is unset or does not match.
# Events are kept for 30 days and listed under Admin > WhatsApp.
WHATSAPP_WEBHOOK_SECRET=replace_with_random_secret
# More accepted secrets, comma separated, e.g. one per domain or while rotating.
# WHATSAPP_WEBHOOK_SECRETS=

BOT_TOKEN=1234567890:telegram_bot_token_here
TELEGRAM_BOT_ENABLED=true
TELEGRAM_ADMIN_USERNAMES=your_telegram_username
LITECHEATS_STATUS_BASE_URL=https://litecheats.com
TELEGRAM_WEBHOOK_PATH=/telegram-webhook
TELEGRAM_WEBHOOK_BASE_URL=https://litecheats.com
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace_with_random_secret
TELEGRAM_DEV_WEBHOOK_TUNNEL=false
TELEGRAM_DEV_WEBHOOK_TUNNEL_PORT=8080

# ---------------------------------------------------------------------------
# Razorpay payments
# ---------------------------------------------------------------------------
# API keys from Dashboard > Account & Settings > API Keys. Use rzp_test_* keys
# in development. Checkout is disabled entirely when these are unset.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Secret you typed when creating the webhook in Dashboard > Settings > Webhooks.
# Deliveries are rejected with 401 when this is unset or does not match.
RAZORPAY_WEBHOOK_SECRET=replace_with_random_secret

# Razorpay issues one secret per webhook. If you run a webhook per domain (or
# are rotating a secret), list the extra ones here, comma separated. A delivery
# is accepted when it matches any configured secret.
# RAZORPAY_WEBHOOK_SECRETS=secret_for_second_domain,secret_for_third_domain

# GST added on top of the catalogue price, as a percentage. Default 18.
RAZORPAY_TAX_PERCENT=18

# Optional. Set a Razorpay plan id (Dashboard > Subscriptions > Plans) to switch
# that tier from a prepaid one-time order to an auto-recurring subscription.
# RAZORPAY_PLAN_ID_INSTITUTION_MONTHLY=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_ID_INSTITUTION_ANNUAL=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_ID_ENTERPRISE_MONTHLY=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_ID_ENTERPRISE_ANNUAL=plan_xxxxxxxxxxxxxx

# Billing cycles a subscription mandate runs for before it must be re-authorised.
# Defaults to 12 for monthly plans and 5 for annual plans.
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12
