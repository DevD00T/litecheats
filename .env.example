NODE_ENV=development
# If your platform uses lowercase env keys, `node_env` is also supported:
# node_env=development

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Litecheats Enquiry <onboarding@resend.dev>"
RESEND_TO_EMAIL=support@litecheats.com

# Public URL this app is reachable at, used to build links sent in emails
# (e.g. the signup email-verification link). No trailing slash.
PUBLIC_APP_URL=http://localhost:8080

# SQLite data file. Relative paths resolve against the project root.
SQLITE_PATH=./data/litecheats.sqlite

# Owner account, seeded automatically on first boot if no owner exists yet.
# Leave OWNER_PASSWORD unset to have a random password generated and printed
# once to the server console on first run.
OWNER_EMAIL=owner@litecheats.com
OWNER_PASSWORD=
OWNER_FULL_NAME=Owner
OWNER_COMPANY=Litecheats Technologies

BOT_TOKEN=1234567890:telegram_bot_token_here
TELEGRAM_BOT_ENABLED=true
TELEGRAM_ADMIN_USERNAMES=your_telegram_username
LITECHEATS_STATUS_BASE_URL=https://litecheats.com
TELEGRAM_WEBHOOK_PATH=/telegram-webhook
TELEGRAM_WEBHOOK_BASE_URL=https://litecheats.com
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace_with_random_secret
TELEGRAM_DEV_WEBHOOK_TUNNEL=false
TELEGRAM_DEV_WEBHOOK_TUNNEL_PORT=8080
